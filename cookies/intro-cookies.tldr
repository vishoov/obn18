								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "- How many steps are there for implementing jwt"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Explain them"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "-> create -> login -> jwt.sign() -> client "
								}
							]
						},
